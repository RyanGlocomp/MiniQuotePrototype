# Copy to .env. Swapping the model server (Ollama -> vLLM -> NIM) only changes this file.

# api runs with host networking, so the host Ollama is plain localhost.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=not-needed
TEXT_MODEL=qwen3.8:27b
VISION_MODEL=qwen3-vl:8b

# Placeholder pricing rules for the mini build (full build: signed-off method + SST rule).
MARKUP=0.20
TAX_RATE=0.08

# Host ports (127.0.0.1 only). Agree these with other Spark users.
API_PORT=8107
WEB_PORT=3107

# Container user id = your Spark user id, so it can write to ./jobs (run: id -u)
APP_UID=1000
